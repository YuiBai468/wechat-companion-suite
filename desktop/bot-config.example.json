      50,
      160
    ],
    "nudgeMin": [
      6,
      20
    ],
    "angryMin": [
      45,
      110
    ],
    "lastMin": [
      200,
      400
    ],
    "dailyLimit": 5,
    "minGapMin": 40,
    "chance": 0.65,
    "quietHours": [
      1,
      8
    ]
  },
  "humanize": {
    "enabled": true,
    "sleepHours": [
      2,
      8
    ],
    "sleepDelayMin": 40,
    "sleepDelayMax": 150,
    "sleepSilentChance": 0.25,
    "sleepEscalateFactor": 0.55,
    "sleepEscalateWindowMin": 12,
    "sleepWakeWords": [
      "睡不着",
      "失眠",
      "睡不着觉",
      "难受",
      "好难受",
      "想你了",
      "好想你",
      "出事了",
      "怎么办",
      "哭了",
      "救",
      "急",
      "怕"
    ],
    "sleepWakeDelayMin": 6,
    "sleepWakeDelayMax": 25,
    "slowReplyChance": 0.1,
    "slowReplyMin": 3,
    "slowReplyMax": 10
  },
  "schedule": {
    "enabled": false,
    "wake": {
      "enabled": true,
      "at": "07:00",
      "jitterMin": 40
    },
    "meals": [
      {
        "enabled": true,
        "name": "早饭",
        "at": "09:00",
        "jitterMin": 50
      },
      {
        "enabled": true,
        "name": "午饭",
        "at": "12:40",
        "jitterMin": 60
      },
      {
        "enabled": true,
        "name": "晚饭",
        "at": "18:40",
        "jitterMin": 60
      }
    ],
    "sleep": {
      "enabled": true,
      "at": "01:00",
      "jitterMin": 45
    },
    "catchUpMinutes": 60,
    "insomnia": {
      "enabled": true,
      "from": "23:30",
      "to": "00:45",
      "minDays": 1,
      "maxDays": 2,
      "aheadMin": 2,
      "aheadMax": 6
