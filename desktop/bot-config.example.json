    "hrHigh": 150,
    "hrHard": 170,
    "hrExtreme": 190,
    "hrSustainSeconds": 60,
    "spo2Low": 90,
    "stressLow": 20,
    "stressHigh": 40,
    "sleepShortH": 5,
    "sleepLongH": 10,
    "wakeLateHour": 12,
    "nightStartH": 1,
    "nightEndH": 5,
    "sleepFreshMin": 120,
    "workoutGraceMin": 10,
    "workoutStaleHours": 3,
    "hrExtremeInWorkout": 190,
    "cooldownMin": 25,
    "dailyLimit": 10,
    "quietHours": []
  },
  "logFile": "data/logs/wechat-bot.log",
  "memoryFile": "data/memory.json",
  "lifeplan": {
    "enabled": false,
    "chat": "${WECHAT_PRIVATE_CHAT}"
  }
