{
  "baseUrl": "https://api.deepseek.com",
  "model": "deepseek-flash",
  "thinking": "high",
  "temperature": 1.15,
  "maxTokens": 900,
  "credentialsFile": "",
  "credentialsRef": "DEEPSEEK_API_KEY",
  "apiKey": "${DEEPSEEK_API_KEY}",
  "personaFile": "personas/group-friend.md",
  "runtimeNote": "你是一个由用户配置的微信聊天角色。直接输出可以发送的聊天内容；不要输出动作旁白、系统标签或分析过程。",
  "chats": [],
  "nicknames": [],
  "wakeProbability": 0.05,
  "followupSeconds": 0,
  "historyLimit": 12,
  "contextFile": "data/contexts.json",
  "silkDecoder": "bin/silk_v3_decoder.exe",
  "asr": {
    "enabled": false,
    "provider": "qwen",
    "model": "qwen3-asr-flash",
    "ref": "DASHSCOPE_API_KEY",
    "language": "zh",
    "maxSeconds": 180
  },
  "vision": {
    "provider": "qwen",
    "model": "qwen3-vl-plus",
    "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "ref": "DASHSCOPE_API_KEY",
    "maxTokens": 1000,
    "timeoutSeconds": 180,
    "enableThinking": false,
    "enabled": false
  },
  "auxiliary": {
    "provider": "mimo",
    "baseUrl": "https://api.xiaomimimo.com/v1",
    "model": "mimo-v2.6-flash",
    "credentialsFile": "",
    "credentialFormat": "env",
    "thinking": "low",
    "maxTokens": 4096,
    "timeoutSeconds": 60,
    "enabled": true
  },
  "stripEmojiInPrivate": true,
  "image": {
    "enabled": false,
    "model": "qwen-image-3.0-pro",
    "size": "1152*1536",
    "promptExtend": false,
    "ref": "DASHSCOPE_API_KEY",
    "refs": [],
    "saveDir": "data/images",
    "maxPerDay": 4,
    "requireAsk": true,
    "writerModel": "mimo-v2.6-flash",
    "character": "用户配置的角色身份；保持中性，不指向任何真实人物。",
    "referenceMode": "identity-first"
  },
  "sendDelayMin": 1.5,
  "sendDelayMax": 8.0,
  "dailySendLimit": 600,
  "quietHours": [
    2,
    7
  ],
  "readDelay": 0.6,
  "selfSenderId": 2,
  "debounceSeconds": 3.0,
  "debounceMaxSeconds": 9.0,
  "rhythmProfile": "natural",
  "rhythmBurst": 0,
  "rhythmWindow": 0,
  "proactive": {
    "enabled": false,
    "checkSeconds": 30,
