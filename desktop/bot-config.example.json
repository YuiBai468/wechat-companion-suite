    "randomChats": {
      "enabled": true,
      "from": "09:30",
      "to": "23:30",
      "minPerDay": 1,
      "maxPerDay": 3,
      "avoidMinutes": 45
    }
  },
  "health": {
    "enabled": false,
    "port": 8765,
